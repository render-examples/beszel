# Asked for on deploy:
USER_EMAIL=you@example.com

# Set by the Blueprint: APP_URL, USER_PASSWORD (generated).
#
# Optional, add on the beszel service after deploy:
# DISABLE_PASSWORD_AUTH=true      # OAuth/OIDC only (set up a provider first)
# USER_CREATION=true              # let OAuth users create accounts
# MFA_OTP=true                    # email one-time code on sign-in (needs SMTP)
# Full list: https://beszel.dev/guide/environment-variables
